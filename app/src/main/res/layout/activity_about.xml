<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/settings_background" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingBottom="28dp">

        <include layout="@layout/settings_header" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="38dp" android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingHorizontal="18dp">

            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:importantForAccessibility="no" android:src="@mipmap/ic_launcher" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/app_name" android:textColor="@color/settings_text" android:textSize="38sp"
                android:textStyle="bold" android:accessibilityHeading="true" />

            <TextView android:id="@+id/about_version" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:textColor="@color/settings_secondary" android:textSize="15sp" />

            <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textColor="@color/settings_secondary" android:textSize="14sp"
                android:gravity="center" android:accessibilityLiveRegion="polite" />

            <ProgressBar android:id="@+id/update_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:progressTint="@color/settings_accent" android:importantForAccessibility="no" android:visibility="gone" />

            <Button android:id="@+id/update_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:minHeight="48dp" android:minWidth="136dp" android:paddingHorizontal="24dp"
                android:background="@drawable/about_update_button" android:textColor="@android:color/white"
                android:textAllCaps="false" android:textSize="15sp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:background="@drawable/settings_card" android:orientation="vertical" android:padding="18dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/about_description" android:textColor="@color/settings_text" android:textSize="16sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp"
                android:background="@color/settings_divider" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/about_author" android:textColor="@color/settings_secondary" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/about_author_name" android:textColor="@color/settings_text" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
