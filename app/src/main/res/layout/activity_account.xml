<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/settings_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="30dp">
        <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="‹   SIP" android:textSize="18sp" android:textColor="@color/settings_text"
            android:paddingStart="12dp" android:paddingTop="24dp" android:paddingBottom="16dp" android:clickable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Учётная запись" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/settings_text"
            android:paddingStart="12dp" android:paddingTop="30dp" android:paddingBottom="27dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/settings_card" android:clipToOutline="true">
            <include android:id="@+id/user_row" layout="@layout/setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="18dp" android:background="@color/settings_divider" />
            <include android:id="@+id/domain_row" layout="@layout/setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="18dp" android:background="@color/settings_divider" />
            <include android:id="@+id/server_row" layout="@layout/setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="18dp" android:background="@color/settings_divider" />
            <include android:id="@+id/password_row" layout="@layout/setting_row" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Для защищённой регистрации укажите прокси вида sip:server:5061;transport=tls, если это поддерживается вашим провайдером."
            android:textSize="13sp" android:textColor="@color/settings_secondary"
            android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="18dp" />
    </LinearLayout>
</ScrollView>
