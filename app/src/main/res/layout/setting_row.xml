<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="18dp"
    android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="13dp" android:paddingBottom="13dp">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:textColor="@color/settings_text" />
        <TextView android:id="@+id/row_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="13sp" android:textColor="@color/settings_secondary" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›"
        android:textSize="26sp" android:textColor="@color/settings_secondary" android:paddingStart="12dp" />
</LinearLayout>
